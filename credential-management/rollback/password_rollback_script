#!/usr/bin/env bash
# =============================================================================
# rotate_passwords_rollback.sh
# Password Rotation Rollback for Oracle Linux / RHEL Fleet
#
# Author: Erik Shannon
# GitHub: github.com/erik-a-shannon
#
# HOW THIS WORKS:
#   True credential rollback requires knowing the PREVIOUS password.
#   This script handles two scenarios:
#
#   Scenario A — You saved the previous password (recommended workflow):
#     Provide the old password at the prompt and this script will
#     re-apply it across the fleet, effectively reversing the rotation.
#
#   Scenario B — You do NOT have the previous password:
#     The script will set a NEW recovery password that you define,
#     restoring access to the account across all hosts.
#
# IMPORTANT:
#   There is no way to cryptographically recover a lost Linux password.
#   /etc/shadow stores only a one-way hash. This script restores ACCESS,
#   not the original credential value.
#
# Features:
#   - Supports both key-based and password-based SSH in mixed environments
#   - Runtime credential prompting — no hardcoded secrets
#   - Compatible with OL7, OL8, OL9 via chpasswd
#   - Color-coded per-host output and pass/fail summary
#   - Confirmation prompt before executing across fleet
#   - Works with or without sshpass
#
# Requirements:
#   - sshpass for password-based SSH hosts
#     OL/RHEL: sudo yum -y install sshpass  OR  sudo dnf -y install sshpass
# =============================================================================

# ── CONFIGURATION — edit before use ──────────────────────────────────────────
TARGET_USER="YOUR_USERNAME_HERE"    # Account to restore password for
SSH_USER="YOUR_SSH_USER_HERE"       # SSH user with sudo on target hosts
SSH_TIMEOUT=10
# ─────────────────────────────────────────────────────────────────────────────

# ── HOST LIST ─────────────────────────────────────────────────────────────────
# Format: "hostname|auth_type|ssh_password"
#   auth_type = "key"      → uses your default SSH key
#   auth_type = "password" → uses sshpass
# ─────────────────────────────────────────────────────────────────────────────
HOSTS=(
  "server01.example.com|key|-"
  "server02.example.com|key|-"
  "server03.example.com|password|CHANGEME"
  "server04.example.com|password|CHANGEME"
  "server05.example.com|key|-"
)

# =============================================================================

set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info()    { echo -e "${CYAN}[INFO]${RESET}  $*"; }
success() { echo -e "${GREEN}[OK]${RESET}    $*"; }
warn()    { echo -e "${YELLOW}[WARN]${RESET}  $*"; }
error()   { echo -e "${RED}[FAIL]${RESET}  $*"; }

# ── Preflight ─────────────────────────────────────────────────────────────────
preflight() {
  if [[ "$TARGET_USER" == "YOUR_USERNAME_HERE" ]]; then
    echo "ERROR: Set TARGET_USER before running." >&2; exit 1
  fi
  if [[ "$SSH_USER" == "YOUR_SSH_USER_HERE" ]]; then
    echo "ERROR: Set SSH_USER before running." >&2; exit 1
  fi
  command -v ssh &>/dev/null || { echo "ERROR: ssh not found." >&2; exit 1; }
}

# ── SSH wrapper ───────────────────────────────────────────────────────────────
remote_exec() {
  local host="$1" auth_type="$2" ssh_pass="$3"
  shift 3
  local cmd="$*"
  local ssh_opts="-o StrictHostKeyChecking=no -o ConnectTimeout=${SSH_TIMEOUT} -o BatchMode=no"

  if [[ "$auth_type" == "key" ]]; then
    ssh $ssh_opts "${SSH_USER}@${host}" "$cmd" 2>/dev/null
  elif [[ "$auth_type" == "password" ]]; then
    if command -v sshpass &>/dev/null; then
      sshpass -p "$ssh_pass" ssh $ssh_opts "${SSH_USER}@${host}" "$cmd" 2>/dev/null
    else
      warn "sshpass not found for $host — attempting key fallback"
      ssh $ssh_opts "${SSH_USER}@${host}" "$cmd" 2>/dev/null
    fi
  fi
}

# ── Set password on a single host ────────────────────────────────────────────
set_password_on_host() {
  local host="$1" auth_type="$2" ssh_pass="$3" target_pass="$4"
  remote_exec "$host" "$auth_type" "$ssh_pass" \
    "echo '${TARGET_USER}:${target_pass}' | sudo chpasswd" \
    && return 0 || return 1
}

# ── Main ─────────────────────────────────────────────────────────────────────
main() {
  preflight

  echo ""
  echo -e "${BOLD}╔══════════════════════════════════════════════╗${RESET}"
  echo -e "${BOLD}║      Password Rotation Rollback Tool         ║${RESET}"
  echo -e "${BOLD}║      Oracle Linux / RHEL Fleet               ║${RESET}"
  echo -e "${BOLD}╚══════════════════════════════════════════════╝${RESET}"
  echo ""
  info "Target user : $TARGET_USER"
  info "SSH user    : $SSH_USER"
  info "Total hosts : ${#HOSTS[@]}"
  echo ""

  # Scenario selection
  echo -e "${BOLD}Select rollback scenario:${RESET}"
  echo "  1) I have the previous password — restore it across the fleet"
  echo "  2) I do NOT have the previous password — set a new recovery password"
  echo ""
  local scenario
  read -rp "Select [1-2]: " scenario

  local RECOVERY_PASS=""

  case "$scenario" in
    1)
      echo ""
      info "Enter the PREVIOUS password to restore:"
      read -rsp "  Previous password: " RECOVERY_PASS
      echo ""
      if [[ -z "$RECOVERY_PASS" ]]; then
        error "Password cannot be empty. Exiting."; exit 1
      fi
      info "Will restore the previous password across all ${#HOSTS[@]} hosts."
      ;;
    2)
      echo ""
      warn "No previous password available — a new recovery password will be set."
      echo ""
      read -rsp "  Enter new recovery password: " RECOVERY_PASS
      echo ""
      read -rsp "  Confirm new recovery password: " RECOVERY_CONFIRM
      echo ""
      if [[ "$RECOVERY_PASS" != "$RECOVERY_CONFIRM" ]]; then
        error "Passwords do not match. Exiting."; exit 1
      fi
      if [[ -z "$RECOVERY_PASS" ]]; then
        error "Password cannot be empty. Exiting."; exit 1
      fi
      info "Will set new recovery password across all ${#HOSTS[@]} hosts."
      ;;
    *)
      error "Invalid option. Exiting."; exit 1
      ;;
  esac

  echo ""
  warn "══════════════════════════════════════════════"
  warn "  This will change $TARGET_USER's password"
  warn "  across ${#HOSTS[@]} hosts. This cannot be undone"
  warn "  without another rotation."
  warn "══════════════════════════════════════════════"
  echo ""
  read -rp "Type YES to confirm and proceed: " confirm
  [[ "$confirm" != "YES" ]] && { info "Rollback cancelled."; exit 0; }
  echo ""

  local pass_count=0 fail_count=0
  declare -A results

  for entry in "${HOSTS[@]}"; do
    IFS='|' read -r host auth_type ssh_pass <<< "$entry"
    echo -n "  Restoring on $host ... "
    if set_password_on_host "$host" "$auth_type" "$ssh_pass" "$RECOVERY_PASS"; then
      success "done"
      results["$host"]="OK"
      ((pass_count++))
    else
      error "FAILED"
      results["$host"]="FAILED"
      ((fail_count++))
    fi
  done

  echo ""
  echo -e "${BOLD}══════════════════════════════════════════════${RESET}"
  echo -e "${BOLD}  Rollback Summary${RESET}"
  echo -e "${BOLD}══════════════════════════════════════════════${RESET}"
  echo -e "  ${GREEN}Succeeded: $pass_count${RESET}"
  echo -e "  ${RED}Failed:    $fail_count${RESET}"
  echo ""

  if [[ $fail_count -gt 0 ]]; then
    echo -e "${YELLOW}  Failed hosts — manual intervention required:${RESET}"
    for host in "${!results[@]}"; do
      [[ "${results[$host]}" == "FAILED" ]] && echo "    - $host"
    done
    echo ""
    warn "For failed hosts, log in via console or out-of-band access and"
    warn "manually run: echo '${TARGET_USER}:<password>' | sudo chpasswd"
    echo ""
  fi

  echo -e "${BOLD}  Record the restored/recovery password in your password manager.${RESET}"
  echo ""
}

main "$@"
